# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=itinerary360
DB_USER=your_db_user
DB_PASSWORD=your_db_password_here

# ── Redis (optional — used for token revocation persistence) ───
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────────────
APP_NAME=Itinerary 360 API
APP_ENV=development
APP_DEBUG=true

# Add every origin your frontend runs from.
# "null" covers opening HTML files directly from disk (file://).
# Add http://localhost:5173 etc. if you use Vite or another dev server.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,null
